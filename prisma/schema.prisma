generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Channel {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  channelTheme     String
  toneArray        String[]
  nicheConstraints String

  // Format
  aspectRatio     String @default("16:9")
  targetDuration  String @default("~10 minutes")
  targetWordCount Int    @default(1700)
  pacing          String @default("Fast pacing with frequent visual changes (every ~2-5s)")

  // Script Generation
  personaPrompt        String
  scriptSections       Json   // Array of {type, title, targetWordRange, percentageOfTotal, purpose}
  sectionConfigs       Json   // Array of {type, title, targetWordRange, instructions, endingGuidance}
  ideaGenerationPrompt String?
  metadataPersona      String

  // Visual Style
  visualStyleDescription String
  styleInstruction       String
  styleReferencePath     String
  characterBible         String
  characterDisplayNames  Json   // {"THE_VICTIM": "the ordinary person", ...}
  thumbnailStylePrompt   String

  // Voice / TTS
  ttsVoiceName    String  @default("Algenib")
  ttsSpeakingStyle String?

  // AI Models
  textGenModel        String @default("gemini-3-pro-preview")
  sceneBreakdownModel String @default("gemini-2.0-flash")
  imageGenModel       String @default("gemini-3-pro-image-preview")
  ttsModel            String @default("gemini-2.5-pro-preview-tts")
  metadataModel       String @default("gemini-3-pro-preview")

  // Relations
  videos    Video[]
  ideas     Idea[]
  schedules Schedule[]
}

model Idea {
  id          String   @id @default(uuid())
  title       String   @unique
  description String
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  channelId   String?
  videos      Video[]
  channel     Channel? @relation(fields: [channelId], references: [id])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Video {
  id               String      @id @default(uuid())
  ideaId           String?
  channelId        String?
  title            String
  status           VideoStatus @default(queued)
  script           String?
  clickbaitTitles  String[]    @default([])
  seoDescription   String?
  seoKeywords      String[]    @default([])
  thumbnailPrompts String[]    @default([])
  costCents        Int?
  costBreakdown    Json?
  reviewData       Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  assets           Asset[]
  batchJobs        BatchJob[]
  steps            Step[]
  idea             Idea?       @relation(fields: [ideaId], references: [id])
  channel          Channel?    @relation(fields: [channelId], references: [id])
}

model BatchJob {
  id           String   @id @default(uuid())
  videoId      String
  phase        Int
  batchName    String
  status       String   @default("pending")
  sceneIndices Json
  resultFile   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Schedule {
  id            String    @id @default(uuid())
  channelId     String?
  intervalHours Int
  enabled       Boolean   @default(true)
  generateIdeas Boolean   @default(true)
  enableReview  Boolean   @default(false)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  channel       Channel?  @relation(fields: [channelId], references: [id])
}

model RenderLock {
  id       String    @id @default("singleton")
  videoId  String?
  lockedAt DateTime?
}

model Asset {
  id        String    @id @default(uuid())
  videoId   String
  type      AssetType
  filename  String
  path      String
  metadata  Json?
  createdAt DateTime  @default(now())
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Step {
  id         String     @id @default(uuid())
  videoId    String
  step       StepName
  status     StepStatus @default(pending)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

enum VideoStatus {
  queued
  scripting
  scenes
  images
  images_batch1
  images_batch2
  audio
  align
  review
  render
  render_queued
  done
  failed
}

enum AssetType {
  script
  image
  audio
  captions
  video
}

enum StepName {
  ideas
  pick_idea
  scripting
  scenes
  images
  images_batch1
  images_batch2
  audio
  transcribe
  align
  review
  render
}

enum StepStatus {
  pending
  running
  success
  failed
}
