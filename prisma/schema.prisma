generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Idea {
  id          String   @id @default(uuid())
  title       String   @unique
  description String
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  videos      Video[]
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Video {
  id               String      @id @default(uuid())
  ideaId           String?
  title            String
  status           VideoStatus @default(queued)
  script           String?
  clickbaitTitles  String[]    @default([])
  seoDescription   String?
  seoKeywords      String[]    @default([])
  thumbnailPrompts String[]    @default([])
  costCents        Int?
  costBreakdown    Json?
  reviewData       Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  assets           Asset[]
  batchJobs        BatchJob[]
  steps            Step[]
  idea             Idea?       @relation(fields: [ideaId], references: [id])
}

model BatchJob {
  id           String   @id @default(uuid())
  videoId      String
  phase        Int
  batchName    String
  status       String   @default("pending")
  sceneIndices Json
  resultFile   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Schedule {
  id            String    @id @default(uuid())
  intervalHours Int
  enabled       Boolean   @default(true)
  generateIdeas Boolean   @default(true)
  enableReview  Boolean   @default(false)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model RenderLock {
  id       String    @id @default("singleton")
  videoId  String?
  lockedAt DateTime?
}

model Asset {
  id        String    @id @default(uuid())
  videoId   String
  type      AssetType
  filename  String
  path      String
  metadata  Json?
  createdAt DateTime  @default(now())
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Step {
  id         String     @id @default(uuid())
  videoId    String
  step       StepName
  status     StepStatus @default(pending)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

enum VideoStatus {
  queued
  scripting
  scenes
  images
  images_batch1
  images_batch2
  audio
  align
  review
  render
  render_queued
  done
  failed
}

enum AssetType {
  script
  image
  audio
  captions
  video
}

enum StepName {
  ideas
  pick_idea
  scripting
  scenes
  images
  images_batch1
  images_batch2
  audio
  transcribe
  align
  review
  render
}

enum StepStatus {
  pending
  running
  success
  failed
}
