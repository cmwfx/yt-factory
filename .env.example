# Database
DATABASE_URL=postgresql://user:password@localhost:5432/youtube_factory

# Google Cloud / Vertex AI
# Option 1: Service Account (for production)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Option 2: API Key (for development)
GOOGLE_GENAI_API_KEY=your-api-key-here

# AssemblyAI (for transcription)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Assets
STYLE_REFERENCE_PATH=./assets/style-reference.png

# Job Configuration
GENERATE_IDEAS=0
TEST_MODE=false
JOBS_OUTPUT_DIR=./public/jobs
